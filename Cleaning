/*
 * WATER PUMP ONLY CLEANING MECHANISM
 * 
 * Wiring:
 * - TRIGGER_PIN (Pin 2): Pull LOW to run the water pump.
 * - PUMP_PIN (Pin 8): Connect to the water pump relay/driver.
 */

#define TRIGGER_PIN 2
#define PUMP_PIN 8

// Timing setting (in milliseconds)
const int PUMP_TIME = 5000; // Adjust how long the pump runs

void setup() {
  Serial.begin(9600);
  
  pinMode(TRIGGER_PIN, INPUT_PULLUP);
  pinMode(PUMP_PIN, OUTPUT);

  digitalWrite(PUMP_PIN, LOW);
  
  Serial.println("Pump Module Ready.");
}

void loop() {
  if (digitalRead(TRIGGER_PIN) == LOW) {
    Serial.println("Cleaning triggered!");
    executeCleaning();
  }
  
  delay(100); 
}

void executeCleaning() {
  Serial.println("Pump ON");
  digitalWrite(PUMP_PIN, HIGH);
  
  delay(PUMP_TIME); // Run pump for the set duration

  Serial.println("Pump OFF. Cycle complete.");
  digitalWrite(PUMP_PIN, LOW);
  
  delay(3000); // Cooldown to prevent rapid re-triggering
}
